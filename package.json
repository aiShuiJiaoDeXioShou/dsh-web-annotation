{
  "name": "dsh-web-annotation",
  "version": "0.2.0",
  "description": "Annotate elements and regions in the right-Sidebar Browser tab; notes are written straight into the composer, with screenshot-free image attachments.",
  "type": "module",
  "license": "MIT",
  "author": "HXwHSJS",
  "homepage": "https://github.com/aiShuiJiaoDeXioShou/dsh-web-annotation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiShuiJiaoDeXioShou/dsh-web-annotation.git"
  },
  "bugs": {
    "url": "https://github.com/aiShuiJiaoDeXioShou/dsh-web-annotation/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "annotation",
    "web-annotation",
    "browser",
    "webview",
    "ui-review"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "node build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "release:pack": "npm pack"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
